# 把本文件复制到用户目录下的 .relie 文件夹，改名为 transcript.env，再填写两个 Key：
#   Windows：C:\Users\<用户名>\.relie\transcript.env
#   macOS / Linux：~/.relie/transcript.env
# 不要把填好 Key 的文件放进技能目录或代码仓库。

# TikHub：https://user.tikhub.io 登录后在「API 令牌」里创建
TIKHUB_API_KEY=
# 国内网络访问 api.tikhub.io 不稳定时，可改成 TikHub 文档里提供的国内域名
TIKHUB_BASE_URL=https://api.tikhub.io

# 阿里云百炼：必须是「华北2（北京）」地域的 API Key
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
ASR_MODEL=paraformer-v2

# ---- 以下一般不用改 ----
# TikHub 解析并发数（官方限速 10 QPS，太高会被限流）
PARSE_WORKERS=5
# 每个转写任务包含的文件数（百炼上限 100）
BATCH_SIZE=100
# 同时进行中的转写任务数
MAX_INFLIGHT_TASKS=10
# 查询转写进度的间隔（秒）
POLL_INTERVAL=5
# 转写任务超过多少分钟未完成就自动重新提交一次；重试后仍超时才记为失败
TASK_TIMEOUT_MIN=20
# 可选：百炼热词表 ID，提高人名、品牌名、行业术语的识别准确率
HOTWORDS_VOCAB_ID=
# 可选：固定输出目录（默认是运行命令时所在目录下的 relie-transcripts）
# OUT_DIR=
# 调试用：设为 1 会把 TikHub 原始返回保存到 输出目录/raw
# DEBUG_RAW=1
